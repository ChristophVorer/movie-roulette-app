{
  "expo": {
    "name": "Movie Roulette",
    "slug": "movie-roulette-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/movie-roulette-logo-with-background.png",
    "scheme": "movierouletteapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.christophvorer.movieroulette",
      "icon": "./assets/logo/movie-roulette-logo-with-background.png"
    },
    "android": {
      "package": "com.christophvorer.movieroulette",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/logo/movie-roulette-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/movie-roulette-logo-with-background.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/logo/movie-roulette-logo.png",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
